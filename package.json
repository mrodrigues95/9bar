{
	"name": "9bar",
	"version": "1.0.0",
	"type": "module",
	"description": "A pnpm workspace for 9bar",
	"packageManager": "pnpm@11.17.0",
	"private": true,
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Marcus Rodrigues",
		"url": "https://mrodrigues.me"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"engines": {
		"pnpm": ">=11.0.0",
		"npm": "pnpm",
		"yarn": "pnpm",
		"node": ">=24.0.0"
	},
	"scripts": {
		"web": "pnpm --filter @9bar/web",
		"toolkit": "pnpm --filter @9bar/toolkit",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"lint:ci": "biome ci .",
		"typecheck": "pnpm -r typecheck"
	},
	"intent": {
		"skills": [
			"@tanstack/*"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^24.13.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
