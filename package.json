{
	"name": "9bar",
	"version": "1.0.0",
	"private": true,
	"description": "A pnpm workspace for 9bar",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Marcus Rodrigues",
		"url": "https://mrodrigues.me"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"web": "pnpm --filter @9bar/web",
		"toolkit": "pnpm --filter @9bar/toolkit",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "pnpm -r typecheck"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^24.13.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": "pnpm",
		"pnpm": ">=11.0.0",
		"yarn": "pnpm"
	},
	"packageManager": "pnpm@11.17.0",
	"intent": {
		"skills": [
			"@tanstack/*"
		]
	}
}
