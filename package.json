{
	"name": "9bar",
	"version": "1.0.0",
	"private": true,
	"description": "A pnpm workspace for 9bar",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Marcus Rodrigues",
		"url": "https://mrodrigues.me"
	},
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools"
	],
	"type": "module",
	"scripts": {
		"web": "pnpm --filter @9bar/web",
		"toolkit": "pnpm --filter @9bar/toolkit",
		"lab": "pnpm --filter @9bar/design-lab",
		"tools": "pnpm --filter @9bar/tools",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:structure",
		"check:structure": "pnpm tools check:structure",
		"control": "pnpm tools control",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"react-doctor": "react-doctor . --include-untracked",
		"react-doctor:full": "react-doctor . --scope full"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@interfere/landmines": "0.1.0",
		"@types/node": "^24.13.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.94.0",
		"react-doctor": "0.9.14",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": "pnpm",
		"pnpm": ">=11.0.0",
		"yarn": "pnpm"
	},
	"packageManager": "pnpm@11.17.0",
	"intent": {
		"skills": [
			"@tanstack/*"
		]
	}
}
