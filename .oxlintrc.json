{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "react", "jsx-a11y", "import"],
	"categories": {
		"correctness": "error"
	},
	"options": {
		"typeAware": true,
		"reportUnusedDisableDirectives": "error"
	},
	"rules": {
		"typescript/array-type": [
			"error",
			{
				"default": "generic",
				"readonly": "generic"
			}
		],
		"typescript/no-inferrable-types": "error",
		"eslint/arrow-body-style": ["error", "as-needed"],
		"eslint/curly": "error",
		"eslint/func-style": ["error", "expression"],
		"eslint/no-unused-vars": "error",
		"react/exhaustive-deps": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-comments": [
			"error",
			{
				"publicApi": ["/packages/toolkit/src/"]
			}
		],
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-effect": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-manual-memo": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"landmines-testing/no-test-doubles": "error",
		"landmines-testing/no-fixed-sleep": "error",
		"landmines-testing/no-unsignaled-poll": "error",
		"landmines-testing/no-flake-masking": "error",
		"landmines-testing/strict-msw": "error",
		"landmines-structure/colocated-tests": "error",
		"landmines-structure/test-file-names": "error",
		"landmines-structure/package-exports": "error",
		"landmines-types/no-explicit-return-types": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-unnecessary-condition": "error",
		"typescript/no-unsafe-type-assertion": "error",
		"typescript/strict-boolean-expressions": "error",
		"unicorn/explicit-length-check": "error",
		"import/no-cycle": "error",
		"anti-slop/type-naming": "error"
	},
	"overrides": [
		{
			"files": ["packages/toolkit/src/**"],
			"rules": {
				"anti-slop/react-aria-import-alias": "error",
				"anti-slop/max-class-string-length": "error",
				"anti-slop/require-export-jsdoc": "error"
			}
		},
		{
			"files": ["apps/web/src/components/**", "apps/web/src/utils/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**/routes/**", "**/routeTree.gen"],
								"message": "Shared code never imports route code. Move the shared piece into src/components or src/utils."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/toolkit/src/components/primitive/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["#composed/*", "**/composed/**"],
								"message": "Primitives never import composed components. Move the shared piece into a primitive."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/toolkit/src/components/composed/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["#composed/*"],
								"message": "Inside composed, import sibling composed components relatively."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": [
		".agents/**",
		"**/*.gen.*",
		"**/dist/**",
		"**/storybook-static/**",
		"**/.tanstack/**",
		"node_modules/**",
		"tools/oxlint/anti-slop/**"
	],
	"jsPlugins": [
		{
			"name": "anti-slop",
			"specifier": "./tools/oxlint/anti-slop/index.ts"
		},
		{
			"name": "landmines-testing",
			"specifier": "@interfere/landmines/testing"
		},
		{
			"name": "landmines-structure",
			"specifier": "@interfere/landmines/structure"
		},
		{
			"name": "landmines-types",
			"specifier": "@interfere/landmines/types"
		}
	]
}
