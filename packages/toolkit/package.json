{
	"name": "@9bar/toolkit",
	"version": "1.0.0",
	"private": true,
	"description": "Primitive design system for 9bar",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"imports": {
		"#components/*": "./src/components/primitive/*/index.ts",
		"#composed/*": "./src/components/composed/*/index.ts",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib/*": "./src/utils/*.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./components": "./src/components/index.ts",
		"./components/*": "./src/components/primitive/*/index.ts",
		"./components/primitive": "./src/components/primitive/index.ts",
		"./components/primitive/*": "./src/components/primitive/*/index.ts",
		"./components/composed": "./src/components/composed/index.ts",
		"./components/composed/*": "./src/components/composed/*/index.ts",
		"./utils": "./src/utils/index.ts",
		"./hooks/*": "./src/hooks/*.ts",
		"./globals.css": "./src/styles/globals.css"
	},
	"scripts": {
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "catalog:",
		"@tanstack/react-form": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "catalog:",
		"react-aria": "^3.50.0",
		"react-aria-components": "catalog:",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.2.1",
		"@rolldown/plugin-babel": "catalog:",
		"@storybook/addon-a11y": "10.5.4",
		"@storybook/addon-docs": "10.5.4",
		"@storybook/addon-mcp": "0.7.0",
		"@storybook/addon-themes": "10.5.4",
		"@storybook/addon-vitest": "10.5.4",
		"@storybook/react-vite": "10.5.4",
		"@tailwindcss/vite": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "4.1.12",
		"babel-plugin-react-compiler": "catalog:",
		"globals": "^17.8.0",
		"playwright": "1.65.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"storybook": "10.5.4",
		"tailwindcss": "catalog:",
		"tailwindcss-react-aria-components": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
