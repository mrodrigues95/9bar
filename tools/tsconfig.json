{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"lib": ["ESNext", "DOM"]
	},
	"include": [
		"checks/**/*.ts",
		"config/**/*.ts",
		"control/**/*.ts",
		"oxlint/**/*.ts",
		"../oxlint.config.ts",
		"../oxfmt.config.ts"
	]
}
